# Build artifacts and runtime state — never committed
build/
.cache/
.env
*.db
# data/*, not data/: a negated pattern can't re-include a file inside a
# directory that's itself ignored, so data/ stays traversable and only its
# contents are ignored by default...
data/*
# ...except hand-authored source content that happens to live under data/,
# e.g. data/syllabus.yaml (curriculum authored by hand, not scraped or
# generated). Runtime data (retrieved web evidence, downloaded weights) is
# unaffected: it never matches *.yaml.
!data/*.yaml

# Python / uv
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.venv/
*.egg-info/

# Seeded design canvas — ~2.5MB of editor payload baked around design/*.dc.html.
# A build artifact of `seed-canvas.mjs`, regenerable; see design/README.md.
design/coursec-editorial-ink.html
